# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (Postgres) ---
# Local:      postgresql://postgres:postgres@localhost:5432/ham
# Render/Neon/Supabase: use the connection string they give you
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ham

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- LLM (Google Gemini — free tier, no card required) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Email (pick ONE provider) ---
EMAIL_PROVIDER=smtp   # smtp | sendgrid | mailgun
EMAIL_FROM="Clinic Appointments <no-reply@yourclinic.dev>"

# SMTP (works with Gmail app password, Mailtrap, etc. — good for local dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Mailgun (if EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- Google Calendar (OAuth 2.0) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the "Google Calendar API" on the project first.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# --- Background jobs ---
SLOT_HOLD_MINUTES=10
REMINDER_CRON="*/15 * * * *"
EMAIL_RETRY_CRON="*/5 * * * *"
